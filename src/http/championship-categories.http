### -------------------------------------------
### CREATE - Categoría KUMITE Open (Sin límite de peso)
# 📝 Crea una categoría de KUMITE Open (cualquier peso)
# 🥋 Cinturones: Marrón 3er Kyu (ID: 8) a Negro (ID: 11)
# 📅 Rango de edad: Senior (ID: 1)
POST http://localhost:3000/api/championships/1/categories
Content-Type: application/json

{
  "code": "KUM_M_SENIOR_OPEN",
  "modality": "Kumite",
  "gender": "Masculino",
  "beltMinId": 8,
  "beltMaxId": 11,
  "ageRangeId": 1,
  "weight": null
}

### -------------------------------------------
### GET One Category by ID
# Obtiene los detalles de la categoría con ID=10 (AJUSTA ESTE ID)
GET http://localhost:3000/api/championship-categories/10

### -------------------------------------------
### UPDATE - Cambiar código de categoría
# 📝 Actualiza solo el código de la categoría con ID=1
PUT http://localhost:3000/api/championship-categories/1
Content-Type: application/json

{
  "code": "KATA_M_SENIOR_UPDATED"
}

### -------------------------------------------
### UPDATE - Cambiar peso de categoría KUMITE
# ⚖️ Actualiza el peso de la categoría con ID=2
PUT http://localhost:3000/api/championship-categories/2
Content-Type: application/json

{
  "weight": "-75kg"
}

### -------------------------------------------
### UPDATE - Cambiar cinturones permitidos
# 🥋 Actualiza el rango de cinturones de la categoría con ID=3
PUT http://localhost:3000/api/championship-categories/3
Content-Type: application/json

{
  "beltMinId": 6,
  "beltMaxId": 11
}

### -------------------------------------------
### UPDATE - Cambiar modalidad y género
# 🔄 Actualiza la modalidad y género de la categoría con ID=4
PUT http://localhost:3000/api/championship-categories/4
Content-Type: application/json

{
  "modality": "Kata",
  "gender": "Femenino",
  "weight": null
}

### -------------------------------------------
### DELETE a Category
# Elimina la categoría con ID=10 (AJUSTA ESTE ID)
DELETE http://localhost:3000/api/championship-categories/59


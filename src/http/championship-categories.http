### championships-categories.http
# Pruebas para el módulo de categorías (con campo 'weight')

### 📋 REFERENCIA DE IDs DISPONIBLES (Desde seed.ts)
# 
# 🥋 CINTURONES (Belt):
#   ID: 1  - Blanco 10mo Kyu (kyuLevel: 10)
#   ID: 2  - Amarillo 9no Kyu (kyuLevel: 9)
#   ID: 3  - Naranja 8vo Kyu (kyuLevel: 8)
#   ID: 4  - Naranja Punta Verde 7mo Kyu (kyuLevel: 7)
#   ID: 5  - Verde 6to Kyu (kyuLevel: 6)
#   ID: 6  - Azul 5to Kyu (kyuLevel: 5)
#   ID: 7  - Azul Punta Marrón 4to Kyu (kyuLevel: 4)
#   ID: 8  - Marrón 3er Kyu (kyuLevel: 3)
#   ID: 9  - Marrón 2do Kyu (kyuLevel: 2)
#   ID: 10 - Marrón 1er Kyu (kyuLevel: 1)
#   ID: 11 - Negro (kyuLevel: 0) ⭐ Más común en competencias
#
# 📅 RANGOS DE EDAD (AgeRange):
#   ID: 1 - Senior (18-35 años)
#   ID: 2 - Junior (16-17 años)
#   ID: 3 - Cadete (14-15 años)
#   ID: 4 - Infantil (12-13 años)
#
# 🏆 CAMPEONATOS:
#   ID: 1 - Campeonato Nacional Universitario de Karate 2025
#   ID: 2 - (Crea más según necesites)
#

### -------------------------------------------
### GET All Categories (Simple List)
# Obtiene todas las categorías (sin paginar) para el campeonato con ID=1
GET http://localhost:3000/api/championships/1/categories/all

### -------------------------------------------
### GET Paginated Categories
# Obtiene las categorías paginadas para el campeonato con ID=1
GET http://localhost:3000/api/championships/1/categories?page=1&limit=5

### -------------------------------------------
### CREATE - Categoría KATA Masculino Senior (Sin peso)
# 📝 Crea una categoría de KATA para Senior Masculino
# 🥋 Cinturones: Negro (ID: 11)
# 📅 Rango de edad: Senior (ID: 1)
POST http://localhost:3000/api/championships/2/categories
Content-Type: application/json

{
  "code": "KATA_M_SENIOR_001",
  "modality": "Kata",
  "gender": "Masculino",
  "beltMinId": 11,
  "beltMaxId": 11,
  "ageRangeId": 1,
  "weight": null
}

### -------------------------------------------
### CREATE - Categoría KATA Femenino Senior (Sin peso)
# 📝 Crea una categoría de KATA para Senior Femenino
# 🥋 Cinturones: Negro (ID: 11)
# 📅 Rango de edad: Senior (ID: 1)
POST http://localhost:3000/api/championships/1/categories
Content-Type: application/json

{
  "code": "KATA_F_SENIOR_001",
  "modality": "Kata",
  "gender": "Femenino",
  "beltMinId": 11,
  "beltMaxId": 11,
  "ageRangeId": 1,
  "weight": null
}


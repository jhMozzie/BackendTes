    "seed:roles": "ts-node prisma/seed_roles.ts",
    "seed:belts": "ts-node prisma/seed_belts.ts",
    "seed:admin": "ts-node prisma/seed_admin.ts",
    "seed:main": "ts-node prisma/seed.ts",
    "seed:all": "npm run seed:roles && npm run seed:belts && npm run seed:admin && npm run seed:phases && npm run seed:age-ranges && npm run seed:championships && npm run seed:categories && npm run seed:students",

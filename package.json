    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "prisma": "6.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
